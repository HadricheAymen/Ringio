# Copy this file to .env and fill in real values.
# The real .env is gitignored and must never be committed to this public repository.

# Shared secret that external voice agents must present to use the protected
# transcript and artifact routes. Generate any long random string and use the
# same value in mock-external-service/.env.
INTERNAL_AGENT_TOKEN=change-me

# Optional local overrides (defaults shown):
# PORT=4100
# HOST=0.0.0.0
# REDIS_URL=redis://localhost:6379
