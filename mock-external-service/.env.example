# Copy this file to .env and fill in real values.
# The real .env is gitignored and must never be committed to this public repository.
# These values are server-side only: never expose them to the browser or mobile app.

# Google AI Studio key used by the Gemini Live session.
GEMINI_API_KEY=your-gemini-api-key

# Base URL of the Ringio call server. Use your PC's LAN IPv4 so WebRTC can reach
# this machine; npm run start:agent:local and the console detect it automatically.
CALL_SERVER_URL=http://<your-PC-LAN-IP>:4100

# Simulated destination number routed to the mobile app (no real call is made).
SIMULATED_DESTINATION_NUMBER=+15550001234

# Must match INTERNAL_AGENT_TOKEN in voip-call-server/.env.
INTERNAL_AGENT_TOKEN=change-me
