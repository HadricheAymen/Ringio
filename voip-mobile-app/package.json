{
  "name": "voip-mobile-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-incall-manager": "^4.3.0",
    "react-native-webrtc": "^124.0.8",
    "socket.io-client": "^4.8.4"
  },
  "scripts": {
    "start": "expo start",
    "start:local": "node scripts/start-local.js",
    "start:vercel": "cross-env EXPO_PUBLIC_CALL_SERVER_URL=https://voip-ringio-prototype.vercel.app expo start --dev-client --clear --lan",
    "dev": "expo start --dev-client --clear",
    "android": "expo run:android",
    "android:dev": "expo run:android --device-id 192.168.100.3:40163",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "phone": "adb reverse tcp:8081 tcp:8081 && expo start --dev-client --clear",
    "phone:build": "node scripts/install-android.js",
    "lint": "expo lint"
  },
  "private": true,
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "cross-env": "^7.0.3"
  }
}
